(version 1)
(allow default)
; Applied to the Python bridge and inherited by every CLI and grandchild.
; Quota collection never needs personal documents or the home Git repository.
(deny file-read* file-write*
    (subpath (param "DESKTOP"))
    (subpath (param "DOCUMENTS"))
    (subpath (param "DOWNLOADS"))
    (subpath (param "PICTURES"))
    (subpath (param "MOVIES"))
    (subpath (param "MUSIC"))
    (subpath (param "HOME_GIT")))

; Only app-owned code/resources may be read when the app is in Downloads/Desktop.
(allow file-read* (subpath (param "APP_RESOURCES")))
